# Khai báo IAM Resource
# Create User 
{% if iam_type == 'user' %}
resource "aws_iam_user" "user_{{ iam_name | replace('-', '_') }}" {
  name = "{{ iam_name }}"
  tags = { ManagedBy = "AI-Agent" }
}

# Create Group 
{% elif iam_type == 'group' %}
resource "aws_iam_group" "group_{{ iam_name | replace('-', '_') }}" {
  name = "{{ iam_name }}"
}

# Create Policy
{% elif iam_type == 'policy' %}
resource "aws_iam_policy" "policy_{{ iam_name | replace('-', '_') }}" {
  name        = "{{ iam_name }}"
  description = "Policy generated by AI Agent"
  policy      = <<EOF
{{ policy_document }}
EOF
}

# Attach Policy 
{% elif iam_type == 'attach_group_policy' %}
resource "aws_iam_group_policy_attachment" "attach_{{ iam_name | replace('-', '_') }}" {
  group      = "{{ target_group }}"
  
  # Logic phân biệt ARN chuẩn và Policy tự tạo
  {% if policy_arn.startswith('arn:') %}
  policy_arn = "{{ policy_arn }}"
  {% else %}
  # Nếu không bắt đầu bằng arn:, tự động tham chiếu đến policy vừa tạo ở step trước
  policy_arn = aws_iam_policy.policy_{{ policy_arn | replace('-', '_') }}.arn
  {% endif %}
}
{% endif %}

# XỬ LÝ LỖI ĐỒNG BỘ CỦA AWS IAM
# Tạo một khoảng trễ 10 giây khi hủy tài nguyên để AWS kịp gỡ Policy trước khi xóa Group
resource "time_sleep" "wait_iam_detach" {
  # Phụ thuộc vào TẤT CẢ các attachment được sinh ra
  # (Khi destroy, Terraform sẽ destroy attachment trước, sau đó chờ 10s ở đây, rồi mới destroy Group/Policy)
  destroy_duration = "10s"
  
  depends_on = [
    # Tên của các resource attachment trong template của bạn
    # Ví dụ: aws_iam_group_policy_attachment.attach_AttachReadLogsPolicyToLogViewers,
    # aws_iam_group_policy_attachment.attach_AttachS3FullAccessToDataAdmins
  ]
}
